{
  "name": "ssa-kingo-companion",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "킹고 컴패니언: 성균관대 비교과·교과 선택을 돕는 에이전트 프로토타입 (SSA)",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit && vitest run",
    "preview": "vite preview",
    "test": "vitest",
    "audit:entries": "vitest run src/app/audit --silent=false",
    "audit:layout": "node scripts/audit-layout/run.mjs",
    "audit:copy": "node scripts/audit-copy/run.mjs",
    "server": "node --env-file-if-exists=.env server/main.ts",
    "cli": "node --env-file-if-exists=.env server/cli.ts",
    "build:ops": "vite build --config web/ops/vite.config.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.17",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.17",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.64.1",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.5"
  }
}
