# 학교 데스크톱 묶음의 설정(research R20). kingo.env로 복사해 쓰고 커밋하지 않는다
# 컨테이너 안의 값이다. 호스트 포트·백업 폴더는 deploy/.env의 KINGO_PORT·KINGO_BACKUP_HOST_DIR·KINGO_GOLD_HOST_DIR(compose.yaml 머리 참고)
KINGO_MODE=dev
POSTGRES_PASSWORD=바꿔-주세요
DATABASE_URL=postgres://kingo:바꿔-주세요@db:5432/kingo
OLLAMA_HOST=ollama:11434
KINGO_API_URL=http://proxy:8080
KINGO_BACKUP_DIR=/backup
KINGO_CONSENT_FILE=/config/consent.md
KINGO_OPERATORS_FILE=/config/operators.json
# 알림(3단계): 'node server/cli.ts push-keys'가 준 공개 키와 서비스 주소(https). 개인 키는 kingo.push.env에만 둔다
# KINGO_PUSH_PUBLIC_KEY=
# KINGO_PUBLIC_URL=https://kingo.example.ac.kr
# KINGO_LLM_MODEL=gemma4:12b
# 분야 판 파일 폴더(4단계, jobs). compose는 이름 있는 볼륨 taxonomy-versions를 붙인다
# KINGO_TAXONOMY_VERSIONS_DIR=/app/etl/taxonomy/versions
